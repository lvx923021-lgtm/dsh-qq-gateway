# 依赖与运行配置
# 复制成 .env 后填自己的值：cp config.env.example .env && chmod 600 .env

# DeepSeek API（网关直连模式，以及 DSH headless 子进程都要用）
DEEPSEEK_API_KEY=

# 你的 QQ 号：只有这个号会被当作「他」
OWNER_QQ=

# 只回这些人，逗号分隔；留空 = 所有私聊都回
BOT_ALLOW_QQ=

# 群里必须 @ 才回（1/0）
GROUP_REPLY_NEED_AT=1

# 这些群不用 @ 也回，逗号分隔群号
GROUP_ALWAYS_REPLY=

# 闲聊走哪条路：api = 直连（快） / dsh = 全部走 DSH（慢，有人格和工具）
QQ_MODE=api

# 私聊是否走 DSH（心事本）：1/0
OWNER_DSH=1

# 连发合并窗口（秒）
MERGE_WINDOW=4

# 主动搭话：时间段（小时）、每天最多几次
PROACTIVE_WINDOW=9-23
MAX_PROACTIVE=3

# 身份文件（她是谁）
IDENTITY_FILE=
